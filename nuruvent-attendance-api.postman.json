{
  "info": {
    "name": "Nuruvent Attendance API",
    "description": "Attendance module endpoints. Covers: registering attendees, creating sessions, issuing join tokens, redeeming them, recording attendance, host confirm/override, reporting, and Zoom webhook ingestion. Public endpoints (join, webhooks) skip auth; all others require a valid JWT.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "access_token", "value": "" },
    { "key": "attendee_id", "value": "" },
    { "key": "session_id", "value": "" },
    { "key": "external_id", "value": "" },
    { "key": "external_type", "value": "event" },
    { "key": "registration_external_id", "value": "" },
    { "key": "join_token", "value": "" },
    { "key": "display_name", "value": "Jane Doe" },
    { "key": "email", "value": "jane@example.com" },
    { "key": "zoom_secret", "value": "REPLACE_WITH_ZOOM_SECRET_TOKEN" },
    { "key": "zoom_meeting_id", "value": "98765432100" },
    { "key": "provider_url", "value": "https://zoom.us/j/98765432100" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{access_token}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Attendees",
      "item": [
        {
          "name": "1. Register Attendee",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "if (res.data && res.data.id) {",
                  "    pm.collectionVariables.set('attendee_id', res.data.id);",
                  "    console.log('Saved attendee_id:', res.data.id);",
                  "    console.log('External:', res.data.external_type, '/', res.data.external_id);",
                  "    console.log('Email:', res.data.email);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/attendees",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "attendees"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"external_type\": \"event_registration\",\n    \"external_id\": \"{{registration_external_id}}\",\n    \"display_name\": \"{{display_name}}\",\n    \"email\": \"{{email}}\"\n}"
            }
          }
        },
        {
          "name": "2. Register Attendee — Missing external_id (400)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/attendees",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "attendees"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"external_type\": \"event_registration\",\n    \"display_name\": \"Jane Doe\",\n    \"email\": \"jane@example.com\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
