    {
      "name": "Zoom Webhook",
      "item": [
        {
          "name": "20. Zoom URL Validation",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Compute the signature the way Zoom does: HMAC-SHA256 of",
                  "// 'v0:' + timestamp + ':' + rawBody, keyed by the secret.",
                  "const secret = pm.collectionVariables.get('zoom_secret');",
                  "const ts = Date.now().toString();",
                  "const rawBody = pm.request.body.raw;",
                  "const message = 'v0:' + ts + ':' + rawBody;",
                  "const signature = 'v0=' + CryptoJS.HmacSHA256(message, secret).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: 'x-zm-request-timestamp', value: ts });",
                  "pm.request.headers.upsert({ key: 'x-zm-signature', value: signature });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "console.log('Response:', JSON.stringify(res, null, 2));",
                  "pm.test('has encryptedToken', () => pm.expect(res.encryptedToken).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/webhooks/zoom",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "webhooks", "zoom"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-zm-request-timestamp", "value": "0" },
              { "key": "x-zm-signature", "value": "REPLACE_WITH_COMPUTED_SIGNATURE" }
            ],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"event\": \"endpoint.url_validation\",\n    \"payload\": {\n        \"plainToken\": \"test-plain-token-abc123\"\n    }\n}"
            }
          }
        },
        {
          "name": "21. Zoom Webhook — Participant Joined",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const secret = pm.collectionVariables.get('zoom_secret');",
                  "const ts = Date.now().toString();",
                  "const rawBody = pm.request.body.raw;",
                  "const message = 'v0:' + ts + ':' + rawBody;",
                  "const signature = 'v0=' + CryptoJS.HmacSHA256(message, secret).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: 'x-zm-request-timestamp', value: ts });",
                  "pm.request.headers.upsert({ key: 'x-zm-signature', value: signature });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "console.log('Response:', pm.response.text());",
                  "console.log('');",
                  "console.log('If an attendee with email', pm.collectionVariables.get('email'), 'is registered for this session,');",
                  "console.log('a new attendance record should now exist. Check via the reporting endpoint.');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
