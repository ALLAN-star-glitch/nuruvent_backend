# .env.example - Template for other developers
# Copy this file to .env and fill in your values
ENVIRONMENT=development
SERVER_PORT=8080

# Database
DB_HOST=localhost
DB_PORT=54582
DB_USER=nuruvent_user
DB_PASSWORD=change_me
DB_NAME=nuruvent
DB_SSL_MODE=disable

# Redis
REDIS_URL=localhost:6379

# JWT
JWT_SECRET=your-secret-key-here
JWT_ACCESS_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=168h

# Email
EMAIL_API_KEY=your-api-key-here
EMAIL_FROM=noreply-nuruvent@nuruvent.com

# Casbin
CASBIN_MODEL=configs/casbin/model.conf
CASBIN_AUTO_LOAD=true
CASBIN_AUTO_LOAD_INTERVAL=10s

# Supabase
SUPABASE_URL=your-supabase-url
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_BUCKET_EVENTS=events
SUPABASE_BUCKET_BUSINESSES=businesses
SUPABASE_BUCKET_PROFILES=profiles
SUPABASE_BUCKET_CERTIFICATES=certificates
SUPABASE_BUCKET_RECORDINGS=recordings

# M-PESA
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_PASSKEY=your-passkey
MPESA_SHORTCODE=174379
MPESA_ENVIRONMENT=sandbox